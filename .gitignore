# Secrets — this repository is PUBLIC. Nothing here may ever be committed.
# Match anywhere in the tree, not just the root, and cover the variants people
# actually create: .env~, dev.env, production.env, .env.local.bak.
.env*
**/.env*
*.env
**/*.env
*.env.*
# Editor backups of name-prefixed env files: dev.env~, production.env.bak
*.env~
**/*.env~
*.env.*~
# Re-include the template. Must come after the patterns above to win.
!.env.example
!**/.env.example
.envrc
.envrc.*
*.pem
*.key
secrets/
.supabase/

# Spreadsheets, and anything the club-workbook importer produces.
#
# The club master workbook holds the names, birth dates and phone numbers of
# forty real people. It is meant to stay where the operator keeps it and is never
# copied into the tree — but "never" was previously enforced only by saying so,
# and `git check-ignore -v probe.xlsx app/out.sql` exited 1 with no output,
# meaning neither was protected by anything.
#
# The generated SQL matters as much as the workbook: it carries the same
# personal data in plain text, and one `> out.sql` inside the repo would make it
# a tracked file. .github/workflows/guard.yml checks for both as well, because
# the whole point is that one of the two layers eventually gets forgotten.
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv
# Importer output, whatever somebody calls it.
*.import.sql
import-output*.sql
app/scripts/import/*.sql

# Dependencies / build output
#
# No trailing slash on node_modules. A trailing slash matches directories only,
# and in a worktree node_modules is often a symlink to the shared checkout — a
# symlink is not a directory, so it stayed tracked. Checking in the shared
# checkout proves nothing: there it is a real directory and looks correctly
# ignored. Verify with `git check-ignore -v app/node_modules` in a worktree
# where it is a symlink.
node_modules
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# Tooling scratch
.claude/worktrees/
_workspace/
.omc/
.DS_Store
*.log
npm-debug.log*

# supabase CLI scratch
app/supabase/.temp/

# Playwright. `.auth/` holds live Supabase sessions for the seeded test
# accounts — short-lived and only ever against our dev project, but they are
# credentials and this repository is public.
app/e2e/.auth/
app/playwright-report/
app/test-results/
app/blob-report/
.playwright-cache/
