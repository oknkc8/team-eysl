# Copy to .env and fill in. .env is git-ignored — this repository is public,
# so no real key or password may ever be committed.
#
# TWO files are needed, because two different things read them:
#   ./.env      — everything below. Used by app/scripts/*.sh (psql, migrations).
#   ./app/.env  — the VITE_* block at the bottom. Vite only reads .env from the
#                 directory it runs in, which is app/.
# Same values, different names. Without app/.env the dev server starts and
# immediately throws on a missing variable.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key. Public by Supabase's design; access control is enforced by RLS,
# never by hiding this value.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Database password from the Supabase dashboard. Quote it — passwords routinely
# contain & ? @ which break unquoted shell sourcing.
SUPABASE_DB_PASSWORD='your-db-password'

# Free-tier direct connections (db.<ref>.supabase.co) are IPv6-only. On an IPv4-only
# host use the session pooler instead, where the user is postgres.<project-ref>.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------------------
# Copy these into app/.env as well — Vite reads that file, not this one.
# Only VITE_-prefixed variables reach the browser bundle, which is why the DB
# password above must never gain that prefix: it would ship to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web push. The PUBLIC half of a VAPID key pair, which is public by design — the
# browser sends it to the push service on every subscribe, so hiding it achieves
# nothing.
#
# THE PRIVATE HALF DOES NOT BELONG HERE, OR ANYWHERE IN THIS REPOSITORY. It is
# what authorises sending notifications to the club, and it belongs only
# wherever the sender runs. A VITE_ prefix would be worse still: that ships the
# value to every visitor.
#
# Generate a pair with `npx web-push generate-vapid-keys` and put the public key
# below. Optional — without it the app runs normally and only 알림 설정 says it
# is not configured yet.
VITE_VAPID_PUBLIC_KEY=
