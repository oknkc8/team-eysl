# Copy to .env and fill in. .env is git-ignored — this repository is public,
# so no real key or password may ever be committed.
#
# TWO files are needed, because two different things read them:
#   ./.env      — everything below. Used by app/scripts/*.sh (psql, migrations).
#   ./app/.env  — the VITE_* block at the bottom. Vite only reads .env from the
#                 directory it runs in, which is app/.
# Same values, different names. Without app/.env the dev server starts and
# immediately throws on a missing variable.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key. Public by Supabase's design; access control is enforced by RLS,
# never by hiding this value.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Database password from the Supabase dashboard. Quote it — passwords routinely
# contain & ? @ which break unquoted shell sourcing.
SUPABASE_DB_PASSWORD='your-db-password'

# Free-tier direct connections (db.<ref>.supabase.co) are IPv6-only. On an IPv4-only
# host use the session pooler instead, where the user is postgres.<project-ref>.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------------------
# The club master workbook, for scripts/import-club-workbook.sh.
#
# Just the file id — the segment between /d/ and /edit in the sheet's URL, not
# the whole URL. scripts/import/source.ts builds the export link from it, which
# is why only the id is configurable: a full URL would let a typo point the
# importer at an arbitrary host.
#
# THIS IS A CREDENTIAL, despite looking like a name. The published export takes
# no authentication, so anyone holding the id can download the workbook — and
# the workbook carries forty real people's names, birth dates and phone
# numbers. It belongs in .env for exactly the same reason the database password
# does, and it must never be committed, defaulted in code, or pasted into a PR.
#
# Without it the importer still runs from a local file argument; only the
# no-argument and scheduled forms need it.
EYSL_WORKBOOK_SHEET_ID=

# ---------------------------------------------------------------------------
# Copy these into app/.env as well — Vite reads that file, not this one.
# Only VITE_-prefixed variables reach the browser bundle, which is why the DB
# password above must never gain that prefix: it would ship to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web push. The PUBLIC half of a VAPID key pair, which is public by design — the
# browser sends it to the push service on every subscribe, so hiding it achieves
# nothing.
#
# THE PRIVATE HALF DOES NOT BELONG HERE, OR ANYWHERE IN THIS REPOSITORY. It is
# what authorises sending notifications to the club, and it belongs only
# wherever the sender runs. A VITE_ prefix would be worse still: that ships the
# value to every visitor.
#
# Generate a pair with `npx web-push generate-vapid-keys` and put the public key
# below. Optional — without it the app runs normally and only 알림 설정 says it
# is not configured yet.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# The sender's secrets, which are NOT environment variables of this app.
#
# Listed here because this is where somebody setting the project up will look,
# and because the one thing worse than an undocumented secret is one that gets
# documented into a file. None of these belong in any .env: they are set on the
# Supabase project, from a shell, and read only inside the Edge Function.
#
#   supabase secrets set \
#     VAPID_PUBLIC_KEY=<the same public key as above> \
#     VAPID_PRIVATE_KEY=<the private half — from the same generate run> \
#     VAPID_SUBJECT=mailto:<a contact the push services can reach> \
#     PUSH_TRIGGER_SECRET=<a long random string; openssl rand -hex 32>
#
# And two rows in the database's own vault, so the triggers in migration 0022
# can call the function and prove the call came from us:
#
#   select vault.create_secret(
#            'https://<project-ref>.supabase.co/functions/v1/push-notify',
#            'push_notify_url');
#   select vault.create_secret('<the same PUSH_TRIGGER_SECRET>',
#                              'push_notify_secret');
#
# The two halves of the VAPID pair must come from one `generate-vapid-keys` run.
# A mismatched pair is the worst failure mode this feature has: every screen
# looks correct, every subscription stores fine, and every notification is
# rejected by the push service with a 401 no member ever sees.
